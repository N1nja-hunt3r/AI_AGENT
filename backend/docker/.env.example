# ---------------------------------------------------------------------------
# AI Operating System - environment configuration template
# Copy this file to .env and replace every placeholder value before
# deploying. Never commit a populated .env file to version control.
# ---------------------------------------------------------------------------

# --- LLM / external API providers ------------------------------------------
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-replace-with-your-anthropic-api-key
GOOGLE_API_KEY=replace-with-your-google-api-key
TAVILY_API_KEY=tvly-replace-with-your-tavily-api-key
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://ai_os:change-me@postgres:5432/ai_os
REDIS_URL=redis://:change-me@redis:6379/0
CHROMA_PATH=/data/chroma

# --- Security -----------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret-key
JWT_SECRET=replace-with-a-long-random-jwt-secret

# --- Application behavior ------------------------------------------------------
LOG_LEVEL=info
MODEL_NAME=claude-sonnet-4-6
TEMPERATURE=0.2
MAX_TOKENS=4096
